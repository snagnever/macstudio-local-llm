     if fmt == "json":
         return render_json(report)
     raise ValueError(f"unknown format: {fmt!r}")
+
+
+GROUP_KEYS = ("month", "category", "account")
+
+
+def group_totals(store: LedgerStore, key: str) -> "OrderedDict[str, Decimal]":
+    """Total amount per group, ordered by group label.
+
+    ``key`` is one of :data:`GROUP_KEYS`; a month label is ``YYYY-MM``.
+    """
+    if key not in GROUP_KEYS:
+        raise ValueError(f"unknown group key: {key!r}")
+    totals: Dict[str, Decimal] = {}
+    for t in store:
+        label = getattr(t, key)
+        totals[label] = totals.get(label, Decimal("0")) + t.amount
+    out: "OrderedDict[str, Decimal]" = OrderedDict()
+    for label in sorted(totals):
+        out[label] = totals[label].quantize(Decimal("0.01"))
+    return out
+
+
+def render_groups_text(groups: "OrderedDict[str, Decimal]") -> str:
+    """One ``<group> <total>`` line per group."""
+    return "\n".join(f"{label} {money(value)}" for label, value in groups.items())
+
+
+def render_groups_json(groups: "OrderedDict[str, Decimal]") -> str:
+    """One JSON object: group label -> total as a number rounded to cents."""
+    return json.dumps({label: as_number(value) for label, value in groups.items()}, sort_keys=True)
+
+
+def render_groups(groups: "OrderedDict[str, Decimal]", fmt: str) -> str:
+    if fmt == "text":
+        return render_groups_text(groups)
+    if fmt == "json":
+        return render_groups_json(groups)
+    raise ValueError(f"unknown format: {fmt!r}")

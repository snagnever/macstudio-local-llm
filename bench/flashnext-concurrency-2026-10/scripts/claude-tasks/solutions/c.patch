+class GroupByTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.csv = Path(self.tmp.name) / "small.csv"
+        self.csv.write_text(SMALL_CSV, encoding="utf-8")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_group_by_month_text(self):
+        code, out = run_main(["report", "--group-by", "month", str(self.csv)])
+        self.assertEqual(code, 0)
+        self.assertEqual(out.splitlines(), ["2025-01 2960.00", "2025-02 -15.99"])
+
+    def test_group_by_account_json(self):
+        code, out = run_main(["report", "--group-by", "account", "--format", "json", str(self.csv)])
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(out), {"Checking": 2960.0, "Visa Card": -15.99})
+
+    def test_group_by_category_uses_categorised_rows(self):
+        code, out = run_main(["report", "--group-by", "category", "--format", "json", str(self.csv)])
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(out), {"Groceries": -40.0, "Income": 3000.0, "Subscriptions": -15.99})
+
+    def test_group_by_month_sums_to_fixture_total(self):
+        code, out = run_main(["report", "--group-by", "month", "--format", "json", str(FIXTURE)])
+        self.assertEqual(code, 0)
+        groups = json.loads(out)
+        self.assertGreaterEqual(len(groups), 14)
+        self.assertTrue(all(len(k) == 7 and k[4] == "-" for k in groups))
+        code, summary = run_main(["report", "--format", "json", str(FIXTURE)])
+        self.assertAlmostEqual(sum(groups.values()), json.loads(summary)["total"], places=2)
+
+    def test_invalid_group_key_is_an_argparse_error(self):
+        with self.assertRaises(SystemExit) as ctx:
+            with contextlib.redirect_stderr(io.StringIO()):
+                main(["report", "--group-by", "payee", str(self.csv)])
+        self.assertEqual(ctx.exception.code, 2)

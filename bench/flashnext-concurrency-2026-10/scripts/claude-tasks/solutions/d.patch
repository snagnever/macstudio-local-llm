diff --git a/tests/run_tests.sh b/tests/run_tests.sh
index 063015d..13cc7b4 100644
--- a/tests/run_tests.sh
+++ b/tests/run_tests.sh
@@ -53,4 +53,27 @@ out=$(bash "$ROOT/verify.sh" --quiet --dest "$t/dest") || rc=$?
 check "verify reports BAD and exits 2 for a corrupted archive" "BAD demo-20260101-120000.tar.gz / rc=2" "$out / rc=$rc"
 rm -rf "$t"
 
+# --- rotate.sh ---------------------------------------------------------------
+t=$(tmpdir)
+for day in 01 02 03; do : > "$t/x-202601$day-000000.tar.gz"; done
+bash "$ROOT/rotate.sh" --quiet --dest "$t" --name x --keep 3 > /dev/null
+check "rotate keeps every archive when exactly KEEP exist" "x-20260101-000000.tar.gz x-20260102-000000.tar.gz x-20260103-000000.tar.gz" "$(cd "$t" && echo *.tar.gz)"
+rm -rf "$t"
+
+# --- verify.sh with a space in the archive name ------------------------------
+t=$(tmpdir)
+mkdir -p "$t/src"
+printf 'hello\n' > "$t/src/hello.txt"
+BACKUP_STAMP=20260101-120000 bash "$ROOT/backup.sh" --quiet --dest "$t/dest" --name "my backup" "$t/src" > /dev/null
+check "verify reports ok for an archive whose name contains a space" "ok my backup-20260101-120000.tar.gz" "$(bash "$ROOT/verify.sh" --quiet --dest "$t/dest")"
+rm -rf "$t"
+
+# --- report.sh ---------------------------------------------------------------
+t=$(tmpdir)
+head -c 10000 /dev/zero > "$t/big-20260101-000000.tar.gz"
+head -c 9999 /dev/zero > "$t/small-20260102-000000.tar.gz"
+check "report ranks sizes numerically, largest first" "big-20260101-000000.tar.gz
+small-20260102-000000.tar.gz" "$(bash "$ROOT/report.sh" --quiet --no-header --dest "$t" | awk '{print $NF}')"
+rm -rf "$t"
+
 [[ $fails -eq 0 ]] && echo "all tests passed" || { echo "$fails test(s) failed"; exit 1; }

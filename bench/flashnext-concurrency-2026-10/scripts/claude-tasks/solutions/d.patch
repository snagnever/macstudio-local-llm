diff --git a/lib/common.sh b/lib/common.sh
new file mode 100644
index 0000000..f16b502
--- /dev/null
+++ b/lib/common.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+# lib/common.sh - code shared by every script of the backup toolkit: the
+# logging helpers (through lib/log.sh), the option parser and resolve_dir.
+#
+# Usage, at the top of a script:
+#   source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
+#   usage() { ... }
+#   parse_local_option() { ... }     # optional, see below
+#   parse_args "$@"
+#
+# parse_args fills DEST, NAME, KEEP, QUIET, DRY_RUN and the positional array
+# ARGS. Not every script uses every option (--keep means nothing to backup.sh,
+# for instance) but every script accepts the whole set so that a flag behaves
+# the same everywhere.
+#
+# Script-specific flags are handled by parse_local_option, which a script may
+# define before calling parse_args. It must set CONSUMED to the number of
+# words it used (1 for a bare flag, 2 for "--flag VALUE") and return 0, or
+# return 1 to report an unknown option. The default accepts nothing.
+#
+# bash 3.2 compatible: no associative arrays, no ${var,,}, no mapfile.
+
+if [[ -n "${__BACKUP_COMMON_SH_LOADED:-}" ]]; then
+  return 0 2>/dev/null || true
+fi
+__BACKUP_COMMON_SH_LOADED=1
+
+# Name the log lines after the script, not after this library.
+: "${LOG_PREFIX:=$(basename "${BASH_SOURCE[1]:-$0}")}"
+
+source "$(dirname "${BASH_SOURCE[0]}")/log.sh"
+
+DEST=""
+NAME=""
+KEEP=""
+QUIET=0
+DRY_RUN=0
+ARGS=()          # positional arguments, in order
+CONSUMED=0       # set by parse_local_option
+
+# is_uint STRING   true for a non-negative decimal integer
+is_uint() {
+  [[ "$1" =~ ^[0-9]+$ ]]
+}
+
+# need_value OPTION [VALUE]   die unless the option received a value
+need_value() {
+  [[ $# -ge 2 && -n "$2" ]] || die 1 "option $1 requires a value (see --help)"
+}
+
+# Default hook: no private options. A script overrides this by defining its
+# own parse_local_option before calling parse_args.
+if ! declare -F parse_local_option > /dev/null; then
+  parse_local_option() {
+    return 1
+  }
+fi
+
+# parse_args ARG...
+# Parse the command line into the variables documented above.
+parse_args() {
+  while [[ $# -gt 0 ]]; do
+    case "$1" in
+      --dest)        need_value "$@"; DEST="$2"; shift 2 ;;
+      --dest=*)      DEST="${1#*=}"; shift ;;
+      --name)        need_value "$@"; NAME="$2"; shift 2 ;;
+      --name=*)      NAME="${1#*=}"; shift ;;
+      --keep)        need_value "$@"; KEEP="$2"; shift 2 ;;
+      --keep=*)      KEEP="${1#*=}"; shift ;;
+      -q|--quiet)    QUIET=1; VERBOSE=0; shift ;;
+      -n|--dry-run)  DRY_RUN=1; shift ;;
+      -h|--help)     usage; exit 0 ;;
+      --)            shift; while [[ $# -gt 0 ]]; do ARGS[${#ARGS[@]}]="$1"; shift; done ;;
+      -*)
+        CONSUMED=0
+        if ! parse_local_option "$@"; then
+          usage >&2
+          die 1 "unknown option: $1"
+        fi
+        [[ "$CONSUMED" -ge 1 ]] || die 1 "internal error: parse_local_option consumed nothing for $1"
+        shift "$CONSUMED"
+        ;;
+      *)             ARGS[${#ARGS[@]}]="$1"; shift ;;
+    esac
+  done
+
+  if [[ -n "$KEEP" ]] && ! is_uint "$KEEP"; then
+    die 1 "--keep expects a non-negative integer, got '$KEEP'"
+  fi
+}
+
+# resolve_dir PATH
+# Print the absolute, symlink-free path of an existing directory, or die.
+# Relative paths are taken from the current working directory.
+resolve_dir() {
+  local p="$1"
+  [[ -n "$p" ]] || die 1 "resolve_dir: empty path"
+  [[ -d "$p" ]] || die 2 "not a directory: $p"
+  (cd "$p" && pwd -P)
+}

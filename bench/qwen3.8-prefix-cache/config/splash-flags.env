# UNVERIFIED: these flag names come from the incoai/splash 1.3.1 README until `splash serve --help` runs on the rig (Task 2 Step 8).
# Sourced by scripts/run-splash.sh. Splash auto-selects the matching DFlash2 draft, so there is no drafter flag.
# --idle-release off keeps the model loaded (the default releases it after 10 idle minutes, which would break
# the 10-minute idle gate); --language-only skips the vision tower. KV stays at Splash's default (INT8).
SPLASH_BIN="$HOME/.local/opt/qwen38/splash-v1.3.1/bin/splash"
SPLASH_SERVE_SUBCMD="serve"
SPLASH_FLAG_MODEL="--model"
SPLASH_FLAG_DRAFTER=""
SPLASH_FLAG_HOST="--host"
SPLASH_FLAG_PORT="--port"
SPLASH_FLAG_CTX="--max-context"
SPLASH_EXTRA_ARGS="--idle-release off --language-only"
SPLASH_HAS_CACHED_TOKENS=unknown

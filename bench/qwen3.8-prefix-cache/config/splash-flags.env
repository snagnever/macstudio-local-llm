# Verified from `splash serve --help` on the rig, 2026-10-13 (Splash 1.3.1).
# Sourced by scripts/run-splash.sh. --draft-model takes the DFlash2 draft repo or a local absolute directory.
# --idle-release off keeps the model loaded (the default releases it after 10 idle minutes, which would break
# the 10-minute idle gate); --language-only skips the vision tower. KV stays at the Splash default (int8).
# --offline needs the target pre-downloaded into the HF cache:
#   python/bin/hf download mlx-community/Qwen3.8-27B-8bit --revision 815b83c0df8ffd1d1b5244cf75fd6ef14fca9ef9
SPLASH_BIN="$HOME/.local/opt/qwen38/splash-v1.3.1/bin/splash"
SPLASH_SERVE_SUBCMD="serve"
SPLASH_FLAG_MODEL="--model"
SPLASH_FLAG_REVISION="--revision"
SPLASH_FLAG_DRAFTER="--draft-model"
SPLASH_FLAG_HOST="--host"
SPLASH_FLAG_PORT="--port"
SPLASH_FLAG_CTX="--max-context"
SPLASH_EXTRA_ARGS="--idle-release off --language-only --no-webui --offline"
SPLASH_HAS_CACHED_TOKENS=unknown
